# Measured shares a local results build keeps beside its output.
/.dp-results-cache/

# Prepared snapshots of the one Distribution Release a build renders: a cache
# keyed by the release bytes and the code that measured them, never a source.
docs/site/.prepared/

# Generated by docs/site/templates/filler_results.py: the invented results
# snapshot the page-template previews render. Derived, never checked in.
docs/site/templates/filler-results/

# Tutorials executed by tests/integration/test_tutorials.py, which the site
# renders: against the public release, and against a local release (whose
# outputs carry that release's contents, so they never leave this machine).
tutorials/_executed/
tutorials/_executed_local/
